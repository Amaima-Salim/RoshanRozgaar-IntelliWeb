# Copy to .env.local and fill in. Never commit .env.local (docs/07 §7).
# Names only here; values come from the team's own accounts.

# Core
DATABASE_URL=postgres://rr:rr@localhost:5433/roshan
# Integration tests create and drop this database on every run.
TEST_DATABASE_URL=postgres://rr:rr@localhost:5433/roshan_test
# Better Auth secret. Required in production; generate with `openssl rand -base64 32`.
SESSION_SECRET=
# Public origin, no trailing slash. On a deployment set it to the live URL (e.g. https://your-app.vercel.app);
# if unset on Vercel it falls back to the project's production domain.
APP_URL=http://localhost:3000

# Auth (docs/05). Demo phone login always works. `full` + the values below enables Google and email codes.
# Google redirect URI: <APP_URL>/api/auth/callback/google. Gmail needs 2-Step Verification + a 16-char App Password.
AUTH_MODE=mock
MOCK_OTP_CODE=123456
# on | off. `off` only for local E2E runs; refused in production.
AUTH_RATE_LIMIT=on
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Roshan Rozgar

# AI (docs/04). live | fixtures | off
AI_MODE=off
GEMINI_API_KEY=
GROQ_API_KEY=
AI_TIMEOUT_MS=8000
# Optional model overrides (defaults: gemini-flash-latest, whisper-large-v3-turbo)
GEMINI_MODEL=
GROQ_STT_MODEL=
# Urdu text to speech (D-50). azure (default: native ur-PK-UzmaNeural / AsadNeural, free F0 tier)
# | gemini (uses GEMINI_API_KEY; Urdu is NOT on Google's supported TTS language list, so expect an accent)
TTS_PROVIDER=azure
GEMINI_TTS_MODEL=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: ur-PK-AsadNeural for a male voice
AZURE_SPEECH_UR_VOICE=
TTS_TIMEOUT_MS=15000

# Payments (docs/06). off | mock | sandbox — never real money.
PAYMENTS_MODE=off
PAYMENTS_PROVIDERS=jazzcash,easypaisa,cash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_BASE_URL=
JAZZCASH_CHECKOUT_PATH=
JAZZCASH_INQUIRY_PATH=
EASYPAISA_MODE=mock
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_BASE_URL=

# Product constants (D-07, docs/01 §6)
DEFAULT_CITY=islamabad
SEARCH_RADIUS_KM=10
OFFER_TTL_HOURS=24
